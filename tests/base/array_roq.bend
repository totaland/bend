# CUDA RoPE at zero and long positions, exact frequencies, reused output padding.
import Base

def bits(+v: F32) -> U32:
  match v:
    case F32{+w}:
      U32{w}

def show(a: Array<F32>) -> String:
  List.show(~&1, ~U32, ~(v => U32.show(v)), Array.to_list(~U32, Array.map(~F32, ~U32, ~(v => bits(v)), a)))

def one(+pos: U32) -> IO(Unit):
  IO.print(show(Array.q4wait(Array.roq(Array.q4new(4n), 4, pos, 16.0))))

def real(+pos: U32) -> IO(Unit):
  IO.print(show(Array.q4wait(Array.roq(Array.q4new(7n), 32, pos, 10000000.0))))

def main() -> IO(Unit):
  do IO<Unit>:
    one(0)
    one(1)
    one(1023)
    real(23)
    real(535)
    real(1047)
    IO.print(show(Array.q4wait(Array.roq(Array.q4new(4n), 0, 0, 16.0))))
