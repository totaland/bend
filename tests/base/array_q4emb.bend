# Positive and negative affine scales, both groups, both rows, plus padding.
import Base

def bits(+v: F32) -> U32:
  match v:
    case F32{+w}:
      U32{w}

def fill(n: Nat, a: Array<U32>, +i: U32) -> Array<U32>:
  match n:
    case 0n:
      Array.set(U32, Array.set(U32, Array.set(U32, Array.set(U32, a, 32, 3196075776), 33, 3221241728),
        34, 1073790848), 35, 3204464256)
    case 1n+p:
      +q = Bool.pick(U32, U32.is_zero((i .&. 1 : U32)), 1985229328, 4275878552)
      fill(p, Array.set(U32, a, i, q), (i + 1 : U32))

def show(a: Array<F32>) -> String:
  List.show(~&1, ~U32, ~(v => U32.show(v)), Array.to_list(~U32, Array.map(~F32, ~U32, ~(v => bits(v)), a)))

def finish(o: Array<F32>, w: Array<U32>) -> IO(Unit):
  _ = w
  IO.print(show(o))

def out(r: Array<U32> & Array<F32>) -> IO(Unit):
  (w, o) = r
  finish(Array.q4wait(o), w)

def one(+row: U32) -> IO(Unit):
  out(Array.q4emb(fill(32n, Array.new(U32, 6n, 0), 0), Array.q4new(8n), row, 128, 2))

def main() -> IO(Unit):
  do IO<Unit>:
    one(0)
    one(1)
